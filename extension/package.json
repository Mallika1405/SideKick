{
  "name": "sidekick-vscode",
  "displayName": "Sidekick",
  "publisher": "sidekick",
  "version": "0.0.5",
  "private": false,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sidekick.skip",
        "title": "Sidekick: Skip current narration"
      },
      {
        "command": "sidekick.toggle.narrate",
        "title": "Sidekick: Toggle narrate"
      },
      {
        "command": "sidekick.toggle.listen",
        "title": "Sidekick: Toggle listen"
      },
      {
        "command": "sidekick.toggle.review",
        "title": "Sidekick: Toggle review"
      },
      {
        "command": "sidekick.toggle.whiteboard",
        "title": "Sidekick: Toggle whiteboard"
      },
      {
        "command": "sidekick.openBoard",
        "title": "Sidekick: Open Whiteboard"
      },
      {
        "command": "sidekick.showLog",
        "title": "Sidekick: Show Log"
      },
      {
        "command": "sidekick.testWebviewMic",
        "title": "Sidekick: Test Microphone in Webview"
      },
      {
        "command": "sidekick.talk",
        "title": "Sidekick: Talk (push to talk)"
      },
      {
        "command": "sidekick.toggleAlwaysOn",
        "title": "Sidekick: Toggle Always-On Mic"
      }
    ],
    "keybindings": [
      {
        "command": "sidekick.skip",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "sidekick.talk",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "configuration": {
      "title": "Sidekick",
      "properties": {
        "sidekick.nativeAudio": {
          "type": "boolean",
          "default": true,
          "description": "Use the editor's native mic and speaker (macOS helper) instead of the browser console tab. Turn off to fall back to the browser tab. Takes effect after reloading the window."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "@sidekick/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "description": "Voice narration, spoken Q&A, bug flags and a live architecture whiteboard for AI-assisted coding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mallika1405/SideKick"
  },
  "categories": [
    "Other"
  ]
}